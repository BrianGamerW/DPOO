@startuml
class Punto2D {
    - coordX: double
    - coordY: double
    
    + Punto2D()
    + Punto2D(x: double, y: double): void
    + setCoordX(x: double): void
    + getCoordX(): double
    + setCoordY(y: double): void
    + getCoordY(): double
}
class Circunferencia {
    - centro: Punto2D
    - radio: double

    + Circunferencia()
    + Circunferencia(radio: double,  x: double, y: double): void
    + Circunferencia(radio: double, centro: Punto2D)
    + setCentro(centro: Punto2D): void
    + getCentro(): Punto2D
    + setRadio(radio: double): void
    + getRadio(): double
}
@enduml
